{
  "name": "iobroker.ai-parakeet",
  "version": "0.1.4",
  "description": "Local speech recognition with NVIDIA Parakeet TDT 0.6B v3 on the CPU: OpenAI-compatible transcription API, sendTo and a live test page",
  "author": {
    "name": "oweitman",
    "email": "oweitman@gmx.de"
  },
  "contributors": [],
  "homepage": "https://github.com/ioBroker/ioBroker.ai-parakeet",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "ai",
    "speech recognition",
    "speech-to-text",
    "stt",
    "transcription",
    "parakeet",
    "whisper",
    "openai",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.ai-parakeet"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "onnxruntime-node": "1.31.1",
    "parakeet.js": "1.4.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.ai-parakeet/issues"
  },
  "main": "build/main.js",
  "workspaces": ["src-webcomponents"],
  "files": [
    "admin/",
    "build/",
    "public/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:webcomponents",
    "build:webcomponents": "npm run build --prefix src-webcomponents",
    "check": "tsc --noEmit -p tsconfig.json && npm run check --prefix src-webcomponents && tsc -p test/wakeword/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs",
    "test:js": "mocha --config test/.mocharc.json \"test/unit/**/*.test.ts\"",
    "test:package": "mocha --config test/.mocharc.json test/package.test.ts",
    "test:integration": "mocha --config test/.mocharc.json test/integration.test.ts",
    "test:wakeword": "node --import tsx --test test/wakeword/*.test.mts",
    "test": "npm run test:js && npm run test:package && npm run test:wakeword",
    "prepublishOnly": "npm run build",
    "dev:upload": "dev-server upload",
    "dev:run": "dev-server run",
    "dev:watch": "dev-server watch --noStart",

    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade",
    "npm": "npm i"
  },
  "readmeFilename": "README.md"
}
